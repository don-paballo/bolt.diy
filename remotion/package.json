{
  "name": "bondboss-broll-video",
  "version": "1.0.0",
  "description": "B-roll video composition for BondBoss UGC content using Remotion",
  "scripts": {
    "start": "remotion studio",
    "build": "remotion render BondBossUGC out/bondboss-ugc.mp4",
    "build:still": "remotion still BondBossUGC --frame=0 out/preview.png",
    "upgrade": "remotion upgrade"
  },
  "dependencies": {
    "@remotion/cli": "^4.0.0",
    "@remotion/player": "^4.0.0",
    "remotion": "^4.0.0"
  },
  "devDependencies": {
    "@types/react": "^18.0.0",
    "@types/react-dom": "^18.0.0",
    "typescript": "^5.0.0"
  },
  "remotion": {
    "entrypoint": "src/index.ts"
  }
}
